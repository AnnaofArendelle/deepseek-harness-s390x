+      env: { ...process.env, SAL_DISABLE_PRINTERLIST: '1', SAL_DISABLE_DEFAULTPRINTER: '1' } })
+    let stdout = '', stderr = ''
+    child.stdout.on('data', (bytes: Buffer) => { stdout = (stdout + bytes.toString()).slice(-65536) })
+    child.stderr.on('data', (bytes: Buffer) => { stderr = (stderr + bytes.toString()).slice(-65536) })
+    const stop = (): void => { if (child.pid !== undefined) { try { process.kill(-child.pid, 'SIGKILL') } catch {} } }
