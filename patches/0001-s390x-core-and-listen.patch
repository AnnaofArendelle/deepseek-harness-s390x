+
+/** Adapt atomic syscall results to the existing bootstrap's libc interface. */
+function loadS390xLibc() {
+  const require = createRequire(import.meta.url)
+  const platformPackage = `@deepseek-ai/node-addon-system-${process.platform}-${process.arch}`
+  const manifest = require.resolve(`${platformPackage}/package.json`)
