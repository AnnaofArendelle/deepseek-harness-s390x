+    backend: 'native', render: (request, signal) => convert(request, signal),
+    convert: (request, signal) => convert(request, signal), recalculate: (request, signal) => convert(request, signal, true),
+    async renderImages(request: RenderImagesRequest, signal?: AbortSignal): Promise<RenderImagesResult> {
+      return operation(request.inputPath, signal, async (scratch, combined) => {
+        if (!isAbsolute(request.outputDir)) throw new TypeError('Office image directory must be absolute')
