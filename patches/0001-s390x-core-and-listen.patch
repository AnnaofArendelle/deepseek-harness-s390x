index 00000000..8cd77e6c
--- /dev/null
+++ b/native/system/packages/entry/src/linux-process.c
@@ -0,0 +1,107 @@
+/* Node-API v8 libc bridge. Each result captures errno before calling Node. */
+#include <node_api.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static napi_value invalid(napi_env env, const char *message) {
+  (void)napi_throw_type_error(env, "ERR_INVALID_ARG_VALUE", message);
+  return NULL;
+}
+
+static char *string_value(napi_env env, napi_value value) {
+  size_t size, written;
+  if (napi_get_value_string_utf8(env, value, NULL, 0, &size) != napi_ok)
+    return NULL;
+  char *text = malloc(size + 1);
+  if (text == NULL) { (void)napi_throw_error(env, "ENOMEM", "Cannot allocate syscall arguments"); return NULL; }
+  if (napi_get_value_string_utf8(env, value, text, size + 1, &written) != napi_ok ||
+      written != size || memchr(text, '\0', size) != NULL) {
+    free(text); return NULL;
+  }
+  return text;
+}
+
+static void free_vector(char **values) {
+  if (values == NULL) return;
+  for (size_t i = 0; values[i] != NULL; i++) free(values[i]);
+  free(values);
+}
+
+static char **string_vector(napi_env env, napi_value value) {
+  bool array;
+  uint32_t count;
+  if (napi_is_array(env, value, &array) != napi_ok || !array ||
+      napi_get_array_length(env, value, &count) != napi_ok ||
+      (uint64_t)count + 1 > SIZE_MAX / sizeof(char *)) return NULL;
+  char **values = calloc((size_t)count + 1, sizeof(char *));
+  if (values == NULL) { (void)napi_throw_error(env, "ENOMEM", "Cannot allocate syscall arguments"); return NULL; }
+  for (uint32_t i = 0; i < count; i++) {
+    napi_value entry;
+    if (napi_get_element(env, value, i, &entry) != napi_ok ||
+        (values[i] = string_value(env, entry)) == NULL) {
+      free_vector(values); return NULL;
+    }
+  }
+  return values;
+}
+
+static bool int_value(napi_env env, napi_value value, int *result) {
+  double number;
+  if (napi_get_value_double(env, value, &number) != napi_ok ||
+      !(number >= INT_MIN && number <= INT_MAX) || number != (int)number) return false;
+  *result = (int)number;
+  return true;
+}
+
+static napi_value call_fcntl(napi_env env, napi_callback_info info) {
+  size_t count = 3;
+  napi_value args[3], pair, value;
+  int fd, command, argument;
+  if (napi_get_cb_info(env, info, &count, args, NULL, NULL) != napi_ok || count != 3 ||
+      !int_value(env, args[0], &fd) || !int_value(env, args[1], &command) ||
+      !int_value(env, args[2], &argument)) return invalid(env, "fcntl requires three C integers");
+  if (command != F_GETFD && command != F_SETFD && command != F_GETFL && command != F_SETFL)
+    return invalid(env, "Unsupported fcntl command");
+  int result = fcntl(fd, command, argument);
+  int error = result == -1 ? errno : 0;
+  if (napi_create_array_with_length(env, 2, &pair) != napi_ok ||
+      napi_create_int32(env, result, &value) != napi_ok || napi_set_element(env, pair, 0, value) != napi_ok ||
+      napi_create_int32(env, error, &value) != napi_ok || napi_set_element(env, pair, 1, value) != napi_ok) return NULL;
+  return pair;
+}
+
+static napi_value call_execve(napi_env env, napi_callback_info info) {
+  size_t count = 3;
+  napi_value args[3], value;
+  if (napi_get_cb_info(env, info, &count, args, NULL, NULL) != napi_ok || count != 3)
+    return invalid(env, "execve requires path, argv and envp");
+  char *file = string_value(env, args[0]);
+  char **argv = file == NULL ? NULL : string_vector(env, args[1]);
+  char **envp = argv == NULL ? NULL : string_vector(env, args[2]);
+  if (envp == NULL) {
+    free(file); free_vector(argv);
+    bool pending = false;
+    (void)napi_is_exception_pending(env, &pending);
+    return pending ? NULL : invalid(env, "execve arguments must contain strings without NUL bytes");
+  }
+  execve(file, argv, envp);
+  int error = errno;
+  free(file); free_vector(argv); free_vector(envp);
+  if (napi_create_int32(env, error, &value) != napi_ok) return NULL;
+  return value;
+}
+
+static napi_value initialize(napi_env env, napi_value exports) {
+  napi_property_descriptor methods[] = {
+    { "fcntl", NULL, call_fcntl, NULL, NULL, NULL, napi_default, NULL },
+    { "execve", NULL, call_execve, NULL, NULL, NULL, napi_default, NULL }
+  };
+  if (napi_define_properties(env, exports, 2, methods) != napi_ok) return NULL;
+  return exports;
+}
+NAPI_MODULE(NODE_GYP_MODULE_NAME, initialize)
