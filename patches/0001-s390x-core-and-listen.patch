+      await command('/usr/bin/python3', ['-c', UNO, pipe, JSON.stringify({ input, output, format: extname(output).slice(1), sheet, range, recalculate,
+        maxArchiveEntries: options.maxArchiveEntries ?? 20000, maxUncompressedBytes: options.maxUncompressedBytes ?? 536870912,
+        maxImageResolution: options.maxImageResolution ?? 144 })], signal)
+    } finally { officeAbort.abort(); await office.catch(() => undefined) }
+  }
+  async function pages(pdf: string, signal: AbortSignal): Promise<number> {
+    const count = /\bPages:\s+(\d+)/.exec(await command('/usr/bin/pdfinfo', [pdf], signal))
+    if (count === null) throw failure('invalid-output', 'PDF page count is missing')
+    return Number(count[1])
+  }
+  async function operation<T>(inputPath: string, caller: AbortSignal | undefined, run: (scratch: string, signal: AbortSignal) => Promise<T>): Promise<T> {
+    if (!isAbsolute(inputPath)) throw new TypeError('Office input must be absolute')
+    const previous = tail
+    const task = (async () => {
+      await previous
+      const signal = AbortSignal.any([lifetime.signal, ...(caller === undefined ? [] : [caller]), AbortSignal.timeout(options.timeoutMs ?? 120000)])
+      signal.throwIfAborted()
+      const info = await lstat(inputPath)
+      if (!info.isFile()) throw failure('invalid-document', 'Office input must be a regular file')
+      if (info.size > (options.maxInputBytes ?? 52428800)) throw failure('input-too-large', 'Office input exceeds the byte limit')
+      const scratch = await mkdtemp(join(tmpdir(), 'dsh-system-office-'))
+      try { return await run(scratch, signal) }
+      catch (error) { signal.throwIfAborted(); throw error }
+      finally { await rm(scratch, { recursive: true, force: true }) }
+    })()
+    tail = task.then(() => undefined, () => undefined)
+    pending.add(task)
+    try { return await task } finally { pending.delete(task) }
+  }
+  function convert(request: { inputPath: string; outputPath: string; sheet?: string }, signal?: AbortSignal, recalculate = false): Promise<RenderResult> {
+    return operation(request.inputPath, signal, async (scratch, combined) => {
+      if (!isAbsolute(request.outputPath)) throw new TypeError('Office output must be absolute')
+      const format = extname(request.outputPath).slice(1).toLowerCase()
+      const inputFormat = extname(request.inputPath).slice(1).toLowerCase()
+      const formats = ['doc', 'docx', 'odt'].includes(inputFormat) ? ['pdf', 'docx', 'odt', 'txt']
+        : ['xls', 'xlsx', 'ods'].includes(inputFormat) ? ['pdf', 'xlsx', 'ods', 'csv']
+        : ['ppt', 'pptx', 'odp'].includes(inputFormat) ? ['pdf', 'pptx', 'odp'] : []
