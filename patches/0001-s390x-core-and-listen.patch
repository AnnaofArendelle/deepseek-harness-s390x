+`
+
+function failure(code: string, message: string): Error & { code: string } {
+  return Object.assign(new Error(message), { code })
+}
+
+/** Preserve the kit Converter API while selecting this provider before any WASM operation. */
+export async function createSystemConverter(options: ConverterOptions = {}): Promise<Converter> {
+  for (const path of ['/usr/bin/libreoffice', '/usr/bin/python3', '/usr/bin/pdfinfo', '/usr/bin/pdftoppm']) {
+    try { await access(path, constants.X_OK) }
+    catch { throw failure('unavailable', 's390x Office requires system LibreOffice, python3-uno and poppler-utils. See the installation README.') }
+  }
+  const lifetime = new AbortController()
+  const pending = new Set<Promise<unknown>>()
+  let tail = Promise.resolve()
+  async function command(executable: string, args: string[], signal: AbortSignal): Promise<string> {
+    signal.throwIfAborted()
