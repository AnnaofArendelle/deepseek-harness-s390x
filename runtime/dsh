#!/usr/bin/env bash
set -euo pipefail
runtime_root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
export PATH="$runtime_root/node/bin:$PATH"
export DSH_HOME="${DSH_HOME:-$HOME/.local/share/deepseek-harness}"
exec "$runtime_root/node/bin/node" --expose-internals "$runtime_root/app/entry.mjs" "$@"
