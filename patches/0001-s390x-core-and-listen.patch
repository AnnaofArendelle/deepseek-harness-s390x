+const UNO = String.raw`
+import sys,json,time,uno,zipfile,os
+from com.sun.star.beans import PropertyValue
+from com.sun.star.connection import NoConnectException
+def prop(name,value):
+ p=PropertyValue();p.Name=name;p.Value=value;return p
+pipe,request=sys.argv[1],json.loads(sys.argv[2])
+if os.path.splitext(request['input'])[1].lower() in ('.docx','.xlsx','.pptx','.odt','.ods','.odp'):
+ with zipfile.ZipFile(request['input']) as archive:
+  entries=archive.infolist()
+  if len(entries)>request['maxArchiveEntries'] or sum(e.file_size for e in entries)>request['maxUncompressedBytes']:
+   raise RuntimeError('Office archive exceeds the configured limits')
+  if any(e.flag_bits&1 for e in entries):raise RuntimeError('Encrypted Office archive is unsupported')
+resolver=uno.getComponentContext().ServiceManager.createInstanceWithContext('com.sun.star.bridge.UnoUrlResolver',uno.getComponentContext())
+deadline=time.monotonic()+30
+while True:
+ try:
+  ctx=resolver.resolve('uno:pipe,name='+pipe+';urp;StarOffice.ComponentContext');break
+ except NoConnectException:
+  if time.monotonic()>deadline:raise
+  time.sleep(0.1)
+desktop=ctx.ServiceManager.createInstanceWithContext('com.sun.star.frame.Desktop',ctx)
+doc=None
+try:
+ doc=desktop.loadComponentFromURL(uno.systemPathToFileUrl(request['input']), '_blank',0,
+  (prop('Hidden',True),prop('ReadOnly',False),prop('MacroExecutionMode',0),prop('UpdateDocMode',0)))
+ if doc is None:raise RuntimeError('LibreOffice could not load this document')
+ calc=doc.supportsService('com.sun.star.sheet.SpreadsheetDocument')
+ if request.get('sheet') is not None:
+  if not calc:raise RuntimeError('Sheet selection requires a spreadsheet')
+  sheets=doc.getSheets();name=request['sheet']
+  if not sheets.hasByName(name):raise RuntimeError('Worksheet does not exist')
+  selected=sheets.getByName(name)
+  for n in sheets.getElementNames():sheets.getByName(n).IsVisible=(n==name)
+  doc.getCurrentController().setActiveSheet(selected)
+  if request.get('range') is not None:selected.setPrintAreas((selected.getCellRangeByName(request['range']).getRangeAddress(),))
+ elif request.get('range') is not None:raise RuntimeError('Range selection requires a worksheet name')
+ if request.get('recalculate'):
+  if not calc:raise RuntimeError('Recalculation requires a spreadsheet')
+  doc.calculateAll()
+ filters={'pdf':'calc_pdf_Export' if calc else 'impress_pdf_Export' if doc.supportsService('com.sun.star.presentation.PresentationDocument') else 'writer_pdf_Export',
+  'docx':'Office Open XML Text','odt':'writer8','doc':'MS Word 97','txt':'Text (encoded)',
+  'xlsx':'Calc MS Excel 2007 XML','ods':'calc8','xls':'MS Excel 97',
+  'pptx':'Impress MS PowerPoint 2007 XML','odp':'impress8','ppt':'MS PowerPoint 97','csv':'Text - txt - csv (StarCalc)'}
+ fmt=request['format']
+ if fmt=='csv' and calc and doc.getSheets().getCount()>1 and request.get('sheet') is None:raise RuntimeError('CSV export of multiple worksheets requires a sheet')
