+      await new Promise<void>((resolve, reject) => {
+        child.once('error', reject)
+        child.once('close', code => code === 0 ? resolve() : reject(failure('failed', `${basename(executable)} failed (${code}): ${stderr}`)))
+      })
+      signal.throwIfAborted()
+      return stdout
+    } finally { signal.removeEventListener('abort', stop) }
+  }
+  async function exclusiveOutput(path: string, from: string): Promise<void> {
+    const info = await lstat(from)
+    if (!info.isFile() || info.size === 0) throw failure('invalid-output', 'LibreOffice did not produce a regular nonempty output')
+    if (info.size > (options.maxOutputBytes ?? 104857600)) throw failure('output-too-large', 'Office output exceeds the byte limit')
+    await copyFile(from, path, constants.COPYFILE_EXCL)
+    await chmod(path, 0o600)
+  }
+  async function convertFile(input: string, output: string, scratch: string, signal: AbortSignal,
+    sheet?: string, range?: string, recalculate = false): Promise<void> {
+    const pipe = `dsh_${randomUUID().replaceAll('-', '')}`
+    const profile = pathToFileURL(join(scratch, 'profile')).href
+    const officeAbort = new AbortController()
+    const officeSignal = AbortSignal.any([signal, officeAbort.signal])
+    const office = command('/usr/bin/libreoffice', [`-env:UserInstallation=${profile}`, '--headless', '--nologo', '--nodefault', '--norestore', '--nofirststartwizard',
+      `--accept=pipe,name=${pipe};urp;StarOffice.ServiceManager`], officeSignal)
