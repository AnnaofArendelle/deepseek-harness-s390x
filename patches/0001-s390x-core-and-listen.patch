+ if fmt=='pdf':options.append(prop('FilterData',(prop('ExportBookmarks',False),prop('ReduceImageResolution',True),prop('MaxImageResolution',request['maxImageResolution']))))
+ if fmt=='csv':options.append(prop('FilterOptions','44,34,76,1'))
